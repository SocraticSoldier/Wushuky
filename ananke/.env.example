# ─── ANANKE secrets ──────────────────────────────────────────────────────────
# Copy this file to `.env.local` and fill both secrets. `.env.local` is
# git-ignored; only this example is ever committed.
#
# Generate each with a DIFFERENT value:
#   openssl rand -base64 48   → ANANKE_KEY_SECRET
#   openssl rand -base64 48   → SESSION_SECRET
#
# They are independent on purpose: leaking one does not leak the other.

# Signs and verifies licence keys. Used by scripts/mint-key.mjs and lib/keys.ts.
ANANKE_KEY_SECRET=

# Signs the session cookie set after a successful unlock. Used by lib/session.ts.
SESSION_SECRET=

# Comma-separated list of revoked key ids (the `kid` printed when you mint).
# Add an id here and redeploy to kill that exact key immediately, even if
# it has not expired. Example: ANANKE_REVOKED=jake-phone,client-trial-01
ANANKE_REVOKED=
